FORGEJO____APP_NAME=WAMA Forgejo PoC
FORGEJO__database__DB_TYPE=sqlite3
FORGEJO__database__PATH=/data/gitea/forgejo.db
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__security__DISABLE_GIT_HOOKS=true
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__REQUIRE_SIGNIN_VIEW=true
FORGEJO__actions__ENABLED=true
FORGEJO__actions__DEFAULT_ACTIONS_URL=https://data.forgejo.org
FORGEJO__packages__ENABLED=true
FORGEJO__repository__FORCE_PRIVATE=true
FORGEJO__repository__MAX_CREATION_LIMIT=2
FORGEJO__repository__DISABLE_FORKS=true
FORGEJO__repository__DEFAULT_BRANCH=main
FORGEJO__repository__DEFAULT_REPO_UNITS=repo.code,repo.releases,repo.issues,repo.pulls,repo.packages,repo.actions
FORGEJO__admin__DISABLE_REGULAR_ORG_CREATION=true
FORGEJO__server__START_SSH_SERVER=false
FORGEJO__server__SSH_LISTEN_PORT=22
FORGEJO__server__SSH_PORT=2222