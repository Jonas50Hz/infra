          "builder": {
            "query": "SELECT \"__time\", CASE \"mrid\" WHEN 'urn:wama:poc:pmu:bay-01:voltage-l1' THEN 'L1' WHEN 'urn:wama:poc:pmu:bay-01:voltage-l2' THEN 'L2' WHEN 'urn:wama:poc:pmu:bay-01:voltage-l3' THEN 'L3' END AS \"phase\", \"double_value\" FROM \"live_measurements\" WHERE \"mrid\" IN ('urn:wama:poc:pmu:bay-01:voltage-l1', 'urn:wama:poc:pmu:bay-01:voltage-l2', 'urn:wama:poc:pmu:bay-01:voltage-l3') AND \"mrid\" IN (${mrid:sqlstring}) AND \"quality_valid\" = 'true' AND \"double_value\" IS NOT NULL AND \"__time\" >= MILLIS_TO_TIMESTAMP(${__from}) AND \"__time\" <= MILLIS_TO_TIMESTAMP(${__to}) ORDER BY \"__time\" ASC",
