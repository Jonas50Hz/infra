# Copy values to a shell environment or the repository root .env file before startup.
FORGEJO_DOMAIN=forgejo.example.test
FORGEJO_ROOT_URL=https://forgejo.example.test/
FORGEJO_RUNNER_URL=https://forgejo.example.test/
FORGEJO_BOOTSTRAP_ADMIN_USERNAME=wama-admin
FORGEJO_BOOTSTRAP_ADMIN_EMAIL=wama-admin@example.test
FORGEJO_BOOTSTRAP_ADMIN_PASSWORD=wama-admin
FORGEJO_GATEWAY_C37_118_ONBOARDING_REPOSITORY=gateway-c37-118-onboarding
FORGEJO_GATEWAY_C37_118_ONBOARDING_AGENT_USERNAME=wama-gateway-c37-118-onboarding-agent
FORGEJO_GATEWAY_C37_118_ONBOARDING_AGENT_EMAIL=wama-gateway-c37-118-onboarding-agent@local
WAMA_PROCESSOR_DEPLOY_BASE_ROOT=/var/lib/wama-processors
WAMA_GATEWAY_C37_118_ONBOARDING_DEPLOY_ROOT=/var/lib/wama-gateway-c37-118-onboarding
WAMA_INFRA_NETWORK=wama-infra