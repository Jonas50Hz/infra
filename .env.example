# Infrastructure Compose project and network. This repository is never pushed to Forgejo.
COMPOSE_PROJECT_NAME=infra
WAMA_INFRA_NETWORK=wama-infra

# Browser-visible Grafana origin. Completed measurement-session redirects use it
# unless GRAFANA_SESSION_DASHBOARD_URL supplies an explicit dashboard URL.
GRAFANA_ROOT_URL=http://localhost:3001/

# Forgejo managed repositories and their independent deployment checkouts.
FORGEJO_FREQUENCY_SCALE_REPOSITORY=processor-frequency-scale
FORGEJO_APPARENT_POWER_REPOSITORY=processor-apparent-power
FORGEJO_FREQUENCY_IEC104_EXPORT_REPOSITORY=processor-frequency-iec104-export
FORGEJO_FREQUENCY_MEASUREMENT_SESSION_REPOSITORY=processor-frequency-measurement-session
# Existing managed remotes are dispatched at main on every forgejo-init run.
# Fresh empty remotes rely on their seed push and are not manually dispatched.
# Optional: set only when the processor-alarm-threshold source is available.
FORGEJO_ALARM_THRESHOLD_REPOSITORY=
FORGEJO_GATEWAY_C37_118_REPOSITORY=gateway-c37-118
# Bootstrap creates this restricted, non-admin collaborator for the existing
# private C37.118 gateway repository. Its generated token is not configured here.
FORGEJO_GATEWAY_C37_118_AGENT_USERNAME=wama-gateway-c37-118-agent
FORGEJO_GATEWAY_C37_118_AGENT_EMAIL=wama-gateway-c37-118-agent@local
FORGEJO_MANAGED_REPOSITORIES=processor-frequency-scale,processor-apparent-power,processor-frequency-iec104-export,processor-frequency-measurement-session,gateway-c37-118
WAMA_FREQUENCY_SCALE_DEPLOY_ROOT=/var/lib/wama-processor-frequency-scale
WAMA_APPARENT_POWER_DEPLOY_ROOT=/var/lib/wama-processor-apparent-power
WAMA_FREQUENCY_IEC104_EXPORT_DEPLOY_ROOT=/var/lib/wama-processor-frequency-iec104-export
WAMA_FREQUENCY_MEASUREMENT_SESSION_DEPLOY_ROOT=/var/lib/wama-processor-frequency-measurement-session
# Used only when FORGEJO_ALARM_THRESHOLD_REPOSITORY is configured.
WAMA_ALARM_THRESHOLD_DEPLOY_ROOT=/var/lib/wama-processor-alarm-threshold
WAMA_GATEWAY_C37_118_DEPLOY_ROOT=/var/lib/wama-gateway-c37-118

# The HTTPS hostname must resolve from the Docker host and Actions job containers.
FORGEJO_DOMAIN=forgejo.example.test
FORGEJO_ROOT_URL=https://forgejo.example.test/
FORGEJO_RUNNER_URL=https://forgejo.example.test/

FORGEJO_BOOTSTRAP_ADMIN_USERNAME=wama-admin
FORGEJO_BOOTSTRAP_ADMIN_EMAIL=wama-admin@example.test
FORGEJO_BOOTSTRAP_ADMIN_PASSWORD=wama-admin