# This is the processors repository's Compose project, not infra's project.
WAMA_PROCESSORS_COMPOSE_PROJECT_NAME=wama-processors
WAMA_INFRA_NETWORK=wama-infra

# Forgejo registry path for this processors repository.
WAMA_PROCESSORS_IMAGE_PREFIX=forgejo.example.test/wama-admin/wama-processors
WAMA_PROCESSORS_IMAGE_TAG=main

# The Forgejo deployment runner uses this host path. It is configured by infra.
WAMA_PROCESSORS_DEPLOY_ROOT=/var/lib/wama-processors