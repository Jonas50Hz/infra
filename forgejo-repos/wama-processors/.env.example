# This is the application repository's Compose project, not infra's project.
WAMA_APPS_COMPOSE_PROJECT_NAME=wama-applications
WAMA_INFRA_NETWORK=wama-infra

# Forgejo registry path for this application repository.
WAMA_APPLICATION_IMAGE_PREFIX=forgejo.example.test/wama-admin/wama-applications
WAMA_APPLICATION_IMAGE_TAG=main

# The Forgejo deployment runner uses this host path. It is configured by infra.
WAMA_APPS_DEPLOY_ROOT=/var/lib/wama-applications